# aethericai-gateway 环境（部署到 /etc/aethericai-gateway/gateway.env，chmod 600）
# 共享数据库：复用 /etc/aethericai-auth/auth.env 的 LLMER_DATABASE_PATH / LLMER_HASH_SECRET
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18040
# 请求前余额预检下限（积分）
GATEWAY_MIN_BALANCE=1
# 上游 provider：密钥只存在于本文件，模型路由（对外模型名 → provider/上游模型）在
# 官网管理中心配置（official_llm_models 表）。
GATEWAY_PROVIDER_DEEPSEEK_BASEURL=https://api.deepseek.com/v1
GATEWAY_PROVIDER_DEEPSEEK_KEY=
GATEWAY_PROVIDER_KIMI_BASEURL=https://api.moonshot.cn/v1
GATEWAY_PROVIDER_KIMI_KEY=
